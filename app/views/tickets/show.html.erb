<% content_for :title, "Talep ##{@ticket.id}" %>
<%= link_to "← Destek kuyruğuna dön", tickets_path, class: "back-link" %>
<div class="page-heading ticket-heading"><div><div class="eyebrow">TALEP #<%= @ticket.id.to_s.rjust(4, '0') %></div><h1><%= @ticket.subject %></h1><p><%= @ticket.customer.name %> · <%= clock_label(@ticket.created_at) %></p></div><span class="status <%= @ticket.status %>">● <%= status_label(@ticket) %></span></div>
<div class="detail-grid"><div>
  <section class="conversation-panel"><div class="panel-heading"><h2>Görüşme</h2><span><%= @messages.size + 1 %> mesaj</span></div>
    <article class="message"><div class="message-header"><span class="avatar mint"><%= @ticket.customer.name.first %></span><strong><%= @ticket.customer.name %></strong><span class="message-kind">Müşteri</span><time><%= clock_label(@ticket.created_at) %></time></div><div class="message-body"><%= simple_format(@ticket.description) %></div></article>
    <% @messages.each do |message| %><article class="message <%= message.visibility_internal? ? 'internal-message' : '' %>"><div class="message-header"><span class="avatar <%= message.author.customer? ? 'mint' : '' %>"><%= message.author.name.first %></span><strong><%= message.author.name %></strong><span class="message-kind"><%= message.visibility_internal? ? 'İç not · Yalnızca ekip' : (message.author.agent? ? 'Müşteriye yanıt' : 'Müşteri') %></span><time><%= clock_label(message.created_at) %></time></div><div class="message-body"><%= simple_format(message.body) %></div></article><% end %>
  </section>
  <% if current_user.agent? %>
    <% if @ticket.open? || @ticket.pending? %><section class="compose-panel public-compose"><div class="compose-heading"><span class="compose-icon">↗</span><div><h2>Müşteriye yanıt</h2><p>Alıcı: <strong><%= @ticket.customer.name %></strong> · <%= @ticket.customer.email %></p></div></div><%= form_with url: preview_reply_ticket_path(@ticket) do |f| %><%= f.label :body, "Müşterinin göreceği mesaj", class: "sr-only" %><%= f.text_area :body, id: "public-reply-body", required: true, maxlength: 10000, rows: 5, placeholder: "Bu mesaj müşteriye görünecek. İç yazışmaları burada paylaşmayın." %><div class="compose-footer"><span>Önce alıcı ve içerik önizlemesi</span><%= f.submit "Yanıtı önizle →", class: "button button-primary" %></div><% end %></section><% end %>
    <section class="compose-panel internal-compose"><div class="compose-heading"><span class="compose-icon">▣</span><div><h2>Ekip içi not</h2><p>Yalnızca destek ekibi görür. Müşteriye gönderilmez.</p></div></div><%= form_with url: internal_note_ticket_path(@ticket) do |f| %><%= f.label :body, "Yalnızca ekibin göreceği not", class: "sr-only" %><%= f.text_area :body, id: "internal-note-body", required: true, maxlength: 10000, rows: 4, placeholder: "Ekip arkadaşlarınız için bağlam, inceleme veya takip notu…" %><div class="compose-footer"><span>İç not ilk yanıt süresini durdurmaz</span><%= f.submit "İç notu kaydet", class: "button button-note" %></div><% end %></section>
  <% elsif !@ticket.solved? %><section class="compose-panel"><h2>Destek ekibine yanıt yaz</h2><%= form_with url: customer_reply_ticket_path(@ticket) do |f| %><%= f.label :body, "Mesajınız" %><%= f.text_area :body, required: true, maxlength: 10000, rows: 5 %><div class="form-actions"><%= f.submit "Mesajı gönder →", class: "button button-primary" %></div><% end %></section><% end %>
</div><aside class="detail-aside">
  <section class="info-panel"><h2>Talep bilgileri</h2><dl><dt>Atanan görevli</dt><dd><%= @ticket.assignee&.name || 'Henüz atanmadı' %></dd><dt>Öncelik</dt><dd><%= priority_label(@ticket) %></dd><dt>İlk yanıt hedefi</dt><dd><%= clock_label(@ticket.first_response_due_at) %><span class="sla <%= @ticket.overdue? ? 'late' : '' %>"><%= sla_label(@ticket) %></span></dd><% if @ticket.pending? %><dt>Müşteri yanıtı takibi</dt><dd><%= clock_label(@ticket.follow_up_deadline) %><% if @ticket.follow_up_due? %><span class="follow-up-label">Takip zamanı geldi</span><% end %></dd><% end %><% if @ticket.solved? %><dt>Yeniden açma son zamanı</dt><dd><%= clock_label(@ticket.reopen_deadline) %></dd><% end %></dl>
  <% if current_user.agent? && @ticket.new_ticket? %><%= button_to "Talebi üstlen", assign_ticket_path(@ticket), class: "button button-primary full" %><% end %>
  <% if current_user.agent? && (@ticket.open? || @ticket.pending?) %><% if @ticket.first_response_at.present? %><%= button_to "✓ Çözüldü olarak işaretle", resolve_ticket_path(@ticket), class: "button button-secondary full" %><% else %><p class="muted">Çözümden önce müşteriye bir yanıt gönderin.</p><% end %><% end %>
  <% if @ticket.reopenable? %><%= button_to "↻ Talebi yeniden aç", reopen_ticket_path(@ticket), class: "button button-secondary full" %><% elsif @ticket.solved? %><p class="muted">7 günlük yeniden açma süresi doldu.</p><% end %>
  </section>
  <section class="info-panel"><h2>İşlem geçmişi</h2><ol class="timeline"><% @events.each do |event| %><li><strong><%= event_label(event) %></strong><span><%= event.actor.name %></span><time><%= clock_label(event.created_at) %></time></li><% end %></ol></section>
</aside></div>
